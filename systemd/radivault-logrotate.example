# /etc/logrotate.d/radivault
# audit.log uses explicit chain-aware rotation — we append the head_hash to the
# rotated filename. copy-truncate is FORBIDDEN by FR-27 because it preserves the
# inode and would break the monotonic chain semantics. Therefore we use the
# default create mode (rotate, not copytruncate) and let the gateway reopen the
# file on SIGHUP (v0.2) or daemon restart.

/var/log/radivault/audit.log {
    daily
    rotate 1825
    missingok
    notifempty
    compress
    delaycompress
    create 0600 radivault radivault
    # Rename so the timestamp is visible in the filename.
    dateext
    dateformat -%Y-%m-%dT%H%MZ
    # Note: run `radivault-gateway audit verify` on the rotated file after
    # rotation to establish the genesis for the next log file.
    postrotate
        /bin/true
    endscript
}

/var/log/radivault/app.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    create 0640 radivault radivault
}
