# RadiVault Portal — environment variables
# Copy to .env.local and fill in values for local docker-compose.

# Upstream services (BFF-side only; never exposed to the browser).
CENTRAL_INGEST_URL=http://localhost:8001
SEARCH_URL=http://localhost:8003
FULFILLMENT_URL=http://localhost:8002

# iron-session cookie password. MUST be at least 32 characters in prod.
# Generate whole file with: ./scripts/demo_setup/generate_demo_secrets.sh
SESSION_PASSWORD=change-me-a-local-dev-only-super-long-secret-string

# Demo operator mode — leave empty to disable.
# When empty, POST /api/demoop/enable returns 403 regardless of client state.
DEMOOP_TOKEN=

# Hospital admin tokens (JSON map). v0.1 config-file stub per dev-spec D-5.
# Format: {"hospital_id": "sha256:hex"}  (v0.1 uses SHA-256; v0.1.5 will migrate to argon2id SSO.)
# Plaintext token is entered by the operator in /hospital sign-in; only the hash lives here.
RV_HOSPITAL_ADMIN_TOKENS={}

# Bearer used by the Hospital BFF when calling upstream central-ingest /v1/hospital/me/*.
# In v0.1 this is an auth_token row issued via `ingest-admin token issue`.
# Procedure: docs/ops/demo-deploy-runbook.md §3.
HOSPITAL_UPSTREAM_BEARER=

# Bearer used by the Buyer BFF when proxying to the search/fulfillment services
# on behalf of v0.2 (email/password) sessions. Those sessions intentionally
# carry no `apiKey` on the cookie — the buyer's plaintext is shown ONCE in the
# signup reveal modal and never re-stored client-side.
#
# Issue procedure (run once per environment):
#   docker exec radivault-search-1 search-admin buyer create \
#     --buyer-id buy_portal_internal --company "RadiVault Portal Internal" \
#     --contact-email portal-internal@radivault.local --tier paid --json
#   docker exec radivault-search-1 search-admin key issue \
#     --buyer-id buy_portal_internal --tier paid --expires-days 365 --json
# Copy the `plaintext` field (rv_live_*) into INTERNAL_SEARCH_KEY below.
#
# When unset, every v0.2 BFF call returns 401 ERR_AUTH_EXPIRED with detail
# `no_internal_key`. See web/portal/src/lib/buyer-bearer.ts for semantics.
INTERNAL_SEARCH_KEY=

# Revenue simulation (Hospital Dashboard tile B-2). Placeholder numbers — all
# values display the "시뮬레이션 — v0.2 정산 대기" disclaimer. Adjust freely;
# legal review pending before public disclosure.
NEXT_PUBLIC_DEMO_UNIT_PRICE_USD=5
NEXT_PUBLIC_DEMO_HOSPITAL_SHARE=0.35
NEXT_PUBLIC_DEMO_KRW_PER_USD=1350

# Demo seeding knobs — optional.
TCIA_CACHE_DIR=./demo_data/cache
DEMO_HOSPITAL_ID=hosp_demo_seoul

# Node environment (use "production" when deploying the canned-demo build).
NODE_ENV=development
