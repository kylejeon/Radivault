{
  "name": "@radivault/portal",
  "version": "0.1.0",
  "private": true,
  "description": "RadiVault Buyer Portal + Hospital Dashboard (feature-slug: buyer-portal-demo)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:prod": "NODE_ENV=production next build && bash scripts/check_tbd_in_build.sh",
    "start": "next start -p 3000",
    "lint": "next lint && bash scripts/check_compliance_voice.sh",
    "lint:voice": "bash scripts/check_compliance_voice.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.0",
    "argon2": "^0.44.0",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
